# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Model used for notes/question generation and verification.
OPENAI_MODEL=gpt-4o

# Show notes appearing live (Server-Sent Events) instead of a spinner.
STREAM_NOTES=true

# USD price per 1,000,000 tokens, used to estimate per-chapter cost.
# Set these to match your account's pricing for the model above.
PRICE_INPUT_PER_1M=2.5
PRICE_OUTPUT_PER_1M=10.0

# Enable live internet research while writing notes (OpenAI web_search tool).
# Set to false to generate from the PDF + model knowledge only.
ENABLE_WEB_SEARCH=true

# Deep search: more thorough online research (higher web_search context size).
# Slower and a bit more expensive, but richer notes/sources. Questions are built
# from the researched notes, so they benefit too. Set true to enable.
DEEP_SEARCH=false

# Second pass that renders detailed SVG figures for the notes.
# Each diagram is one extra model call; MAX_DIAGRAMS caps how many per chapter.
ENABLE_DIAGRAMS=true
MAX_DIAGRAMS=8

# Verify a whole set of answers in ONE model call instead of one call per
# question. Much faster and far fewer rate-limit (429) errors. Set false to
# verify one question at a time.
BATCH_VERIFICATION=true

# Reject uploaded PDFs larger than this many megabytes.
MAX_UPLOAD_MB=25

# OCR fallback for scanned / image-only PDFs (no selectable text). Needs the
# Tesseract engine installed on the system:
#   Debian/Ubuntu: apt-get install tesseract-ocr   macOS: brew install tesseract
# Set false to reject scanned PDFs instead of OCR-ing them.
ENABLE_OCR=true
OCR_DPI=200
OCR_MAX_PAGES=50

# Observability
# Log format: "text" (human-readable, default) or "json" (one object per line).
LOG_FORMAT=text
LOG_LEVEL=INFO
# Also write logs to this rotating file (relative to backend/). Empty = console only.
# View it with:  tail -f backend/logs/app.log
LOG_FILE=logs/app.log
# Expose Prometheus metrics at GET /metrics (scrape the backend directly on :8000).
METRICS_ENABLED=true

# Database — switch between SQLite and Postgres here (SQLAlchemy URL).
#   SQLite (default, zero-setup, file relative to the backend/ dir):
DATABASE_URL=sqlite:///./data/study_notes.db
#   Postgres (durable / multi-instance) — uncomment and adjust:
# DATABASE_URL=postgresql+psycopg://studyforge:studyforge@localhost:5432/studyforge
#   With `docker compose --profile postgres up`, use host "postgres":
# DATABASE_URL=postgresql+psycopg://studyforge:studyforge@postgres:5432/studyforge
# Alembic migrations run automatically on startup for either backend.

# CORS: comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
