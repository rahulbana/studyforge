# Frontend for Cloud Run: build the SPA, serve it with nginx, and proxy /api to
# the backend Cloud Run service. (docker-compose still uses ./Dockerfile.)
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
# The nginx image auto-runs envsubst on templates here at startup.
COPY nginx.cloudrun.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

# Only substitute our two vars; leave nginx's own $variables intact.
ENV NGINX_ENVSUBST_FILTER="^(PORT|BACKEND_HOST)$" \
    PORT=8080 \
    BACKEND_HOST=backend:8000

EXPOSE 8080
